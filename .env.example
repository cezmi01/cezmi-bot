# Blockchain Provider
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
# veya alternatif: https://mainnet.infura.io/v3/YOUR_PROJECT_ID

# Wallet Private Key (GÜVENLİK İÇİN .env DOSYASINI .gitignore'A EKLEYİN!)
PRIVATE_KEY=your_private_key_here

# Gas Ayarları
MAX_GAS_PRICE_GWEI=100
GAS_LIMIT=300000

# Arbitraj Ayarları
MIN_PROFIT_PERCENTAGE=0.5  # Minimum kar yüzdesi (%)
SLIPPAGE_TOLERANCE=0.5  # Slippage toleransı (%)

# DEX Ayarları
UNISWAP_V2_ROUTER=0x7a250d5630B4cF539739dF2C5dAcb4c659F2488D
UNISWAP_V3_ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
SUSHISWAP_ROUTER=0xd9e1cE17f2641f24aE83637ab66a2cca9C378B9F

# İzleme Ayarları
POLL_INTERVAL=1  # Saniye cinsinden
MAX_POSITION_SIZE_ETH=1.0  # Maksimum pozisyon büyüklüğü (ETH)
