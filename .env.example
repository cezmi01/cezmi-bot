# BTCTurk Trading Environment Variables Template
# Copy this file to .env and fill in your actual values

# ZORUNLU: Bearer token with "Bearer " prefix
# Get this from your browser's network tab when making authenticated requests
BFF_BEARER=Bearer YOUR_JWT_TOKEN_HERE

# ZORUNLU: Browser cookies from cookie bar
# Copy from browser's cookie storage (btcturk_sess=...; __cf_bm=...; etc)
BFF_COOKIE=YOUR_COOKIES_HERE

# İSTEĞE BAĞLI: Interface configuration
# Kripto interface (recommended)
ORIGIN=https://kripto.btcturk.com
REFERER=https://kripto.btcturk.com/para-yatir/beyan-bekleyen-islemler
APP_NAME=Kripto

# Pro interface (alternative)
# ORIGIN=https://pro.btcturk.com
# REFERER=https://pro.btcturk.com/wallets/deposit
# APP_NAME=Pro

# Description
DESC=Alım satım yapmak için yatırma
