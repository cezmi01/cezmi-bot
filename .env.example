# Bybit API Keys
BYBIT_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here

# Binance API Keys
BINANCE_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# OKX API Keys
OKX_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# BTCTurk API Keys (address_fetcher.py için - opsiyonel)
BTCTURK_KEY=your_btcturk_api_key_here
BTCTURK_SECRET=your_btcturk_secret_here

# Paribu API Keys (address_fetcher.py için - opsiyonel)
PARIBU_KEY=your_paribu_api_key_here
PARIBU_SECRET=your_paribu_secret_here

# Not: BTCTurk ve Paribu API key'leri sadece deposit adreslerini 
# otomatik çekmek için gerekli. Manuel olarak da config.json'a girebilirsiniz.
